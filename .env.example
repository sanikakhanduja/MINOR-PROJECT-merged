# Copy to .env (git-ignored) and fill in ONE provider.
# The strategist picks the first available: groq -> openai -> ollama.
# Force one with LLM_PROVIDER=groq|openai|ollama|heuristic

# --- Groq (OpenAI-compatible) ---
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b        # check https://console.groq.com/docs/models for current IDs
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- OpenAI ---
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Local Ollama (e.g. Llama 3) ---
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.2

# LLM_PROVIDER=groq
